Bootstrap: docker
From: ubuntu:22.04

%labels
    Author CPPxDIC Team
    Version 1.0
    Description Singularity/Apptainer container for CPPxDIC - C++ Digital Image Correlation

%help
    CPPxDIC container for HPC/SLURM clusters.

    Build:
        apptainer build cppxdic.sif cppxdic.def

    Apps baked into the image (select by first argument; default cppxdic):
        cppxdic            camera-pairs 3D-DIC pipeline (default)
        singledic          single-camera 2D DIC
        proxyncorr         pass-through DIC driver over an image folder
        gen_subject_trial  generate subject_trial.csv for SLURM arrays
        xdic_stepsABC      MASK+Seed setup (headless) + StepC DLT calibration
        apptainer run cppxdic.sif --list-apps   # list what is built in

    Run (default cppxdic):
        apptainer run cppxdic.sif --dic-params /path/to/dic_params.txt

    Run (a specific app):
        apptainer run cppxdic.sif singledic --subject S17 --bloc bloc1 --trial vid_23 ...
        apptainer run cppxdic.sif xdic_stepsABC stepc --object obj.txt ...

    Run (with SLURM):
        See submit_job.sh  (APP=singledic sbatch submit_job.sh ...)

%environment
    export LC_ALL=C
    export LANG=C
    export PATH=/opt/cppxdic/bin:$PATH
    export LD_LIBRARY_PATH=/usr/local/lib:/usr/lib/x86_64-linux-gnu:$LD_LIBRARY_PATH
    export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK:-4}

%post
    # =========================================================================
    # System packages
    # =========================================================================
    export DEBIAN_FRONTEND=noninteractive
    # Packages installed:
    #   build-essential, cmake, g++, git, pkg-config  - build tools
    #   libopencv-dev                                  - OpenCV (core, imgproc, imgcodecs, highgui, videoio)
    #   libfftw3-dev                                   - FFTW3
    #   libmatio-dev                                   - MATIO (MATLAB .mat I/O)
    #   libhdf5-dev                                    - HDF5 (required by matio for v7.3 format)
    #   libcgal-dev                                    - CGAL (Delaunay triangulation)
    #   libeigen3-dev                                  - Eigen3 (header-only linear algebra)
    #   libsuitesparse-dev                             - SuiteSparse (spqr, cholmod, amd, colamd)
    #   liblapack-dev, libblas-dev, libopenblas-dev    - BLAS / LAPACK
    #   libomp-dev                                     - OpenMP
    #   nlohmann-json3-dev                             - nlohmann/json (header-only JSON)
    #   pthreads is included in libc (no extra package needed)
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        g++ \
        git \
        pkg-config \
        ca-certificates \
        wget \
        libopencv-dev \
        libfftw3-dev \
        libmatio-dev \
        libhdf5-dev \
        libcgal-dev \
        libeigen3-dev \
        libsuitesparse-dev \
        liblapack-dev \
        libblas-dev \
        libopenblas-dev \
        libomp-dev \
        nlohmann-json3-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

    # =========================================================================
    # Verify all critical libraries are present
    # =========================================================================
    echo "=== Verifying dependencies ==="
    pkg-config --modversion opencv4   || echo "WARN: opencv4 pkg-config missing (may still work)"
    dpkg -s libfftw3-dev              | grep Version
    dpkg -s libmatio-dev              | grep Version
    dpkg -s libhdf5-dev               | grep Version
    dpkg -s libcgal-dev               | grep Version
    dpkg -s libeigen3-dev             | grep Version
    dpkg -s libsuitesparse-dev        | grep Version
    dpkg -s liblapack-dev             | grep Version
    dpkg -s libblas-dev               | grep Version
    dpkg -s libomp-dev                | grep Version
    dpkg -s nlohmann-json3-dev        | grep Version
    echo "=== All dependencies verified ==="

    # =========================================================================
    # Clone and build CPPxDIC
    # =========================================================================
    # Clean any stale build artifacts copied from the host
    rm -rf /opt/cppxdic/src/build
    rm -rf /opt/cppxdic/src/tests/build
    rm -rf /opt/cppxdic/src/Tools/CppNCorr/lib
    rm -f  /opt/cppxdic/src/compile_commands.json
    
    cd /opt/cppxdic/src
    mkdir -p build && cd build
    
    # Optional apps are enabled here (default OFF locally) so they are baked into
    # the image alongside cppxdic and installed onto PATH. xdic_stepsABC is built
    # headless (XDIC_STEPSABC_GUI=OFF) for display-less compute nodes.
    cmake .. \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/cppxdic \
        -DCMAKE_CXX_STANDARD=17 \
        -DBUILD_SINGLEDIC=ON \
        -DBUILD_PROXYNCORR=ON \
        -DBUILD_GEN_SUBJECT_TRIAL=ON \
        -DBUILD_XDIC_STEPSABC=ON \
        -DXDIC_STEPSABC_GUI=OFF

    make -j$(nproc)
    make install

    # Install the shared app dispatcher to a stable path (mirrors the Docker
    # ENTRYPOINT). The %runscript below execs it.
    install -m 0755 /opt/cppxdic/src/deploy/entrypoint.sh /opt/cppxdic/entrypoint.sh
    
    # Also build tests (optional, useful for validation on cluster)
    if [ -d /opt/cppxdic/src/tests ]; then
        mkdir -p /opt/cppxdic/src/tests/build && cd /opt/cppxdic/src/tests/build
        cmake .. \
            -DCMAKE_BUILD_TYPE=Release \
            -DCMAKE_CXX_STANDARD=17
        make -j$(nproc) || echo "WARN: test build had errors (non-fatal)"
    fi

    # Cleanup build artifacts to reduce image size
    rm -rf /opt/cppxdic/src/build
    rm -rf /opt/cppxdic/src/tests/build

%files
    # Copy the entire project source into the container at build time
    # Run: apptainer build cppxdic.sif cppxdic.def   from the CPPxDIC directory
    . /opt/cppxdic/src

%runscript
    # App dispatcher: `apptainer run cppxdic.sif <app> [args]` selects a binary
    # (cppxdic, singledic, proxyncorr, gen_subject_trial, xdic_stepsABC); with no
    # app name it falls through to cppxdic so existing invocations keep working.
    # `apptainer run cppxdic.sif --list-apps` lists what is baked in.
    exec /opt/cppxdic/entrypoint.sh "$@"

%test
    echo "=== Running container self-test ==="
    # Verify each app binary exists, is executable, and has all shared libs.
    for app in cppxdic singledic proxyncorr gen_subject_trial xdic_stepsABC; do
        bin="/opt/cppxdic/bin/${app}"
        test -x "${bin}" || { echo "FAIL: ${app} binary not found"; exit 1; }
        if ldd "${bin}" | grep -q "not found"; then
            echo "FAIL: ${app} has missing shared libs"; ldd "${bin}" | grep "not found"; exit 1
        fi
        echo "OK: ${app}"
    done

    # Verify the default app prints help via the dispatcher.
    /opt/cppxdic/entrypoint.sh --help || { echo "FAIL: cppxdic --help failed"; exit 1; }

    echo "=== Self-test PASSED ==="
