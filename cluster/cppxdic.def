Bootstrap: docker
From: ubuntu:22.04

%labels
    Author CPPxDIC Team
    Version 1.0
    Description Singularity/Apptainer container for CPPxDIC - C++ Digital Image Correlation

%help
    CPPxDIC container for HPC/SLURM clusters.
    
    Build:
        apptainer build cppxdic.sif cppxdic.def
    
    Run (standalone):
        apptainer run cppxdic.sif --dic-params /path/to/dic_params.txt
    
    Run (with SLURM):
        See submit_job.sh

%environment
    export LC_ALL=C
    export LANG=C
    export PATH=/opt/cppxdic/bin:$PATH
    export LD_LIBRARY_PATH=/usr/local/lib:/usr/lib/x86_64-linux-gnu:$LD_LIBRARY_PATH
    export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK:-4}

%post
    # =========================================================================
    # System packages
    # =========================================================================
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        g++ \
        git \
        pkg-config \
        ca-certificates \
        wget \
        # OpenCV
        libopencv-dev \
        # FFTW3
        libfftw3-dev \
        # MATIO (MATLAB .mat I/O)
        libmatio-dev \
        # HDF5 (required by matio for v7.3 format)
        libhdf5-dev \
        # CGAL (Delaunay triangulation)
        libcgal-dev \
        # Eigen3 (header-only linear algebra)
        libeigen3-dev \
        # SuiteSparse (spqr, cholmod, amd, colamd)
        libsuitesparse-dev \
        # BLAS / LAPACK
        liblapack-dev \
        libblas-dev \
        libopenblas-dev \
        # OpenMP
        libomp-dev \
        # nlohmann/json (header-only JSON)
        nlohmann-json3-dev \
        # Pthreads is included in libc
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

    # =========================================================================
    # Verify all critical libraries are present
    # =========================================================================
    echo "=== Verifying dependencies ==="
    pkg-config --modversion opencv4   || echo "WARN: opencv4 pkg-config missing (may still work)"
    dpkg -s libfftw3-dev              | grep Version
    dpkg -s libmatio-dev              | grep Version
    dpkg -s libhdf5-dev               | grep Version
    dpkg -s libcgal-dev               | grep Version
    dpkg -s libeigen3-dev             | grep Version
    dpkg -s libsuitesparse-dev        | grep Version
    dpkg -s liblapack-dev             | grep Version
    dpkg -s libblas-dev               | grep Version
    dpkg -s libomp-dev                | grep Version
    dpkg -s nlohmann-json3-dev        | grep Version
    echo "=== All dependencies verified ==="

    # =========================================================================
    # Clone and build CPPxDIC
    # =========================================================================
    mkdir -p /opt/cppxdic/src
    # Copy source from build context (see %files) — already placed in /opt/cppxdic/src
    
    cd /opt/cppxdic/src
    mkdir -p build && cd build
    
    cmake .. \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/cppxdic \
        -DCMAKE_CXX_STANDARD=17 \
        -DCMAKE_CXX_FLAGS="-O3 -DNDEBUG"
    
    make -j$(nproc)
    make install
    
    # Also build tests (optional, useful for validation on cluster)
    if [ -d /opt/cppxdic/src/tests ]; then
        mkdir -p /opt/cppxdic/src/tests/build && cd /opt/cppxdic/src/tests/build
        cmake .. \
            -DCMAKE_BUILD_TYPE=Release \
            -DCMAKE_CXX_STANDARD=17
        make -j$(nproc) || echo "WARN: test build had errors (non-fatal)"
    fi

    # Cleanup build artifacts to reduce image size
    rm -rf /opt/cppxdic/src/build
    rm -rf /opt/cppxdic/src/tests/build

%files
    # Copy the entire project source into the container at build time
    # Run: apptainer build cppxdic.sif cppxdic.def   from the CPPxDIC directory
    . /opt/cppxdic/src

%runscript
    # Default entrypoint: run cppxdic with all arguments forwarded
    exec /opt/cppxdic/bin/cppxdic "$@"

%test
    echo "=== Running container self-test ==="
    # Verify binary exists and is executable
    test -x /opt/cppxdic/bin/cppxdic || { echo "FAIL: cppxdic binary not found"; exit 1; }
    
    # Verify it can print help
    /opt/cppxdic/bin/cppxdic --help || { echo "FAIL: cppxdic --help failed"; exit 1; }
    
    # Verify shared libraries resolve
    ldd /opt/cppxdic/bin/cppxdic | grep "not found" && { echo "FAIL: missing shared libs"; exit 1; }
    
    echo "=== Self-test PASSED ==="
